# Development image for the ROV2 framework: ROS 2 Jazzy on Ubuntu 24.04 (x86_64).
# LEGACY: the supported workflow is now native WSL (see user_notes.md); this
# image is kept only as an optional fallback.
FROM ros:jazzy-ros-base

ARG WORKSPACE=/workspace/jazzy/mx_jazzhands
ENV WORKSPACE=${WORKSPACE}
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp

SHELL ["/bin/bash", "-lc"]

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      python3-colcon-common-extensions \
      python3-rosdep \
 && rm -rf /var/lib/apt/lists/*

RUN rosdep update || true

# Auto-source the underlay, and the overlay when it exists, on interactive shells.
RUN echo "source /opt/ros/\${ROS_DISTRO}/setup.bash" >> /root/.bashrc \
 && echo "[ -f ${WORKSPACE}/install/setup.bash ] && source ${WORKSPACE}/install/setup.bash" >> /root/.bashrc

WORKDIR ${WORKSPACE}
CMD ["bash"]
